Cell[CellGroupData[{

Cell["Tensors for representing the GR field equations", "Subsubsection",
 CellChangeTimes->{{3.800187199302932*^9, 3.800187219843267*^9}, {
  3.800190038615467*^9, 
  3.800190048380999*^9}},ExpressionUUID->"c0b7ac10-3d94-4378-a28f-\
e2e120c1159e"],

Cell["\<\
These equations should be understood as being equal to zero. Since it is \
easier to manipulate expressions without an equality symbol, it is commonly \
more useful to define field equations as expressions that should be equality \
to zero. Moreover, to change from the latter to full equalities it is easy, \
just add an \[OpenCurlyDoubleQuote]== 0\[CloseCurlyDoubleQuote] (possibly \
with a Thread).\
\>", "Text",
 CellChangeTimes->{{3.8001872341644*^9, 
  3.800187338908836*^9}},ExpressionUUID->"979b1801-8d83-4ba5-ad75-\
63c71961f763"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"gTensor", " ", "=", " ", "$Metric"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GRTensor", "=", " ", 
   RowBox[{"FirstOrder", "[", 
    RowBox[{"GTensor", " ", "-", 
     RowBox[{"8", " ", "\[Pi]", " ", "G0", " ", "TTensor"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GR", "[", 
    RowBox[{"a_", ",", "b_"}], "]"}], " ", ":=", 
   RowBox[{"GRTensor", "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"a", "+", "1"}], ",", 
      RowBox[{"b", "+", "1"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GRtrace", "=", " ", 
   RowBox[{"Contract", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"gI", "[", 
       RowBox[{"a", ",", "b"}], "]"}], " ", 
      RowBox[{"GR", "[", 
       RowBox[{"a", ",", "b"}], "]"}]}], ",", "a", ",", "b"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GRRTensor", " ", "=", " ", 
    RowBox[{"FirstOrder", "[", 
     RowBox[{"GRTensor", " ", "-", 
      RowBox[{
       FractionBox["1", "2"], " ", "GRtrace", " ", "gTensor"}]}], "]"}]}], 
   ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "It", " ", "is", " ", "the", " ", "GR", " ", "equation", " ", "written", " ",
     "with", " ", "the", " ", "Ricci", " ", "tensor", " ", "on", " ", "the", " ",
     "left", " ", "hand", " ", 
    RowBox[{"side", "."}]}], "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Normal", "@", "GRRTensor"}], " ", "//", " ", "TensorPrint"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<---\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Normal", "@", "GRTensor"}], " ", "//", " ", 
  "TensorPrint"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.80018722825452*^9, 3.800187231070533*^9}, {
   3.800187346175808*^9, 3.800187361564704*^9}, {3.800188609089225*^9, 
   3.800188625231876*^9}, {3.800188657599065*^9, 3.800188789715673*^9}, {
