Cell[CellGroupData[{

Cell["Brans-Dicke", "Section",
 CellChangeTimes->{{3.798838774265664*^9, 3.7988387825976562`*^9}, {
  3.798904364007701*^9, 3.798904377356461*^9}, {3.798941015783609*^9, 
  3.79894101606488*^9}, {3.800127557023019*^9, 3.800127557438724*^9}, {
  3.800148452728322*^9, 3.800148453538548*^9}, {3.8447981702224293`*^9, 
  3.8447981723376913`*^9}},ExpressionUUID->"3610e300-86ce-4b2c-8f7a-\
88aebf0250f6"],

Cell["\<\
We can consider the Brans-Dicke field equations in a single \
(matrix/tensorial) equation\
\>", "Text",
 CellChangeTimes->{{3.844798189281406*^9, 
  3.844798258698738*^9}},ExpressionUUID->"d4926008-81c8-48b7-b75d-\
12d6a0f66ae6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "\[Phi]", ",", " ", "\[Xi]", ",", " ", "\[Chi]", ",", " ", "\[Psi]"}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"BransDickeAdd", " ", "=", " ", 
   RowBox[{"Simplify", "@", 
    RowBox[{"FirstOrder", "[", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"\[Phi]", "@", "spacetime"}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"DDCov", "[", 
          RowBox[{"\[Phi]", "@", "spacetime"}], "]"}], "[", "]"}], " ", "-", 
        " ", 
        RowBox[{"$Metric", " ", 
         RowBox[{"TensorBox", "[", 
          RowBox[{"\[Phi]", "@", "spacetime"}], "]"}]}]}], " ", ")"}]}], 
     "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Phi]", "[", "spacetime__", "]"}], ":=", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"\[Sigma]0", " ", "+", " ", 
     RowBox[{"\[CurlyEpsilon]", " ", 
      RowBox[{"\[Sigma]", "[", "spacetime", "]"}]}]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"BDFieldEq", " ", "=", " ", 
   RowBox[{"FirstOrder", "[", 
    RowBox[{"Normal", "[", 
     RowBox[{"GTensor", " ", "-", " ", "BransDickeAdd", " ", "-", "  ", 
      RowBox[{
       FractionBox[
        RowBox[{"8", " ", "\[Pi]", " "}], 
        RowBox[{"\[Phi]", "@", "spacetime"}]], " ", "TTensor"}]}], "]"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"BDFieldEq", " ", "//", " ", 
  "TensorPrint"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.798838786989832*^9, 3.79883884482806*^9}, {
  3.798838881098855*^9, 3.798838914487357*^9}, {3.7988390710023203`*^9, 
  3.7988390782420387`*^9}, {3.798839180280447*^9, 3.798839184251047*^9}, {
  3.798839243500985*^9, 3.798839366218112*^9}, {3.7988400138376713`*^9, 
  3.798840021573264*^9}, {3.798853879562325*^9, 3.798853905417057*^9}, {
  3.798941048578609*^9, 3.798941132534906*^9}, {3.798941263694647*^9, 
  3.798941265006776*^9}, {3.7989416853071947`*^9, 3.7989417029265423`*^9}, {
  3.844798427024406*^9, 3.8447984286096077`*^9}},
 CellLabel->"In[29]:=",ExpressionUUID->"226d7bb4-baf1-4a75-9c22-8bfb206cde3f"],

