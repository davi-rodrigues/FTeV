Cell[BoxData["\<\"Help: Start by defining $Coordinates (coordinates names \
vector) and $Metric (the metric matrix).\"\>"], "Echo",ExpressionUUID->\
"17c74df0-afe6-478c-befe-51d786198447"],

Cell[BoxData["\<\"Use tensorEvaluate[\\\"X\\\"] or tev[\\\"X\\\"] to compute \
X, where X can be: \\n * \\\"Chr\\\" for Christoffel symbol, \\n * \
\\\"Riemann\\\" for Riemann tensor, \\n * \\\"Ricci\\\" for Ricci tensor, \\n \
* \\\"RicciS\\\" for Ricci scalar, \\n * \\\"G\\\" for Einstein tensor, \\n * \
\\\"Weyl\\\" for Weyl tensor, \\n * \\\"Kret\\\" for Kretschmann \
scalar.\"\>"], "Echo",ExpressionUUID->"32275bfd-202e-4b72-979e-37c21a2ac492"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["General Relativity", "Section",
 CellChangeTimes->{{3.800128494072328*^9, 3.800128521848126*^9}, {
   3.800131565365781*^9, 3.800131569215107*^9}, 3.844797468325625*^9, {
   3.844798088102598*^9, 
   3.8447980904760838`*^9}},ExpressionUUID->"908bef5c-e348-4c19-b3a6-\
a8405e88aa9b"],

Cell[TextData[{
 "FTeV introduces two variables to deal with spacetime and space, their names \
are ",
 StyleBox["spacetime", "ExternalLanguage"],
 " and ",
 StyleBox["space", "ExternalLanguage"],
 ". They are shorthand notations for all the \[LineSeparator]coordinate \
names. ",
 StyleBox["TensorPrint", "ExternalLanguage"],
 " hides the space and spacetime coordinates, which is convenient for \
visualization. "
}], "Text",
 CellChangeTimes->{{3.8447982735387383`*^9, 3.844798378610684*^9}, {
   3.848701363256144*^9, 3.848701372999111*^9}, {3.852576530118477*^9, 
   3.85257659338898*^9}, {3.852576664512794*^9, 3.852576732654686*^9}, 
   3.852576787949564*^9},ExpressionUUID->"3df3c8f8-f508-4268-adc3-\
9e352adacc08"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"$Coordinates", "=", 
   RowBox[{"{", 
    RowBox[{"t", ",", "x1", ",", "x2", ",", "x3"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$PerturbationSymbol", " ", "=", " ", "\[CurlyEpsilon]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$Metric", " ", "=", " ", 
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {
       RowBox[{"1", "+", 
        RowBox[{"2", " ", "\[CurlyEpsilon]", " ", 
         RowBox[{"\[Psi]", "@", "spacetime"}]}]}], "0", "0", "0"},
      {"0", 
       RowBox[{"-", " ", 
        RowBox[{"(", 
         RowBox[{"1", " ", "+", " ", 
          RowBox[{"2", " ", "\[CurlyEpsilon]", " ", 
           RowBox[{"\[Chi]", "@", "spacetime"}]}]}], ")"}]}], "0", "0"},
      {"0", "0", 
       RowBox[{"-", " ", 
        RowBox[{"(", 
         RowBox[{"1", " ", "+", " ", 
          RowBox[{"2", " ", "\[CurlyEpsilon]", " ", 
           RowBox[{"\[Chi]", "@", "spacetime"}]}]}], ")"}]}], "0"},
      {"0", "0", "0", 
       RowBox[{"-", " ", 
        RowBox[{"(", 
         RowBox[{"1", " ", "+", " ", 
          RowBox[{"2", " ", "\[CurlyEpsilon]", " ", 
           RowBox[{"\[Chi]", "@", "spacetime"}]}]}], ")"}]}]}
     }], "\[NoBreak]", ")"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.798940913183795*^9, 3.798940970625696*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"9ad8ae90-4dbb-4a3f-9daf-972fb51a06cd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Normal", "@", 
   RowBox[{"FirstOrder", "@", 
    RowBox[{"tev", "[", "\"\<Chr\>\"", "]"}]}]}], " ", "//", " ", 
  "TensorPrint"}]], "Input",
 CellChangeTimes->{{3.798836170359995*^9, 3.798836179558167*^9}, {
  3.79883632281361*^9, 3.798836327772624*^9}, {3.79890659733115*^9, 
