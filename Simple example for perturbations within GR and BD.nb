     " ", 
     RowBox[{"hence", " ", "the", " ", "\[CurlyEpsilon]", " ", 
      RowBox[{"use", "."}]}]}]}], "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
